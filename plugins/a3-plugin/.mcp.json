{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp?client=claude-code-plugin",
      "headers": {
        "Authorization": "${user_config.context7_api_key}"
      }
    },
    "ember": {
      "command": "npx",
      "args": ["-y", "ember-mcp"]
    }
  }
}
